# Milky Way View — server-side configuration (copy to .env.local). No secrets are required:
# the NASA Exoplanet Archive, ESA Gaia Archive and JPL Horizons APIs are public and keyless.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# "live" (default): query upstream services, falling back to bundled samples / the approximate model on failure.
# "sample": never call upstream; use bundled real-data fixtures and the approximate ephemeris model.
DATA_MODE=live

# Per-request timeout for upstream calls, in milliseconds (1000–60000).
UPSTREAM_TIMEOUT_MS=20000
